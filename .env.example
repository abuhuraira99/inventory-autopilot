# =============================================================================
# Inventory Autopilot - server configuration
# =============================================================================
# Copy this to `.env` and fill it in. `.env` is in .gitignore and must never be
# committed.
#
# WHAT BELONGS HERE, AND WHAT DOES NOT
# ------------------------------------
# Here:     infrastructure and identity. The database URL, the encryption key,
#           which Amazon account, which vendor server. These change when the
#           machine or the account changes, never during normal operation.
#
# NOT here: business behaviour. The safety cap, the out-of-stock threshold, the
#           sync interval, the SKU prefixes in scope, who gets alerts. All of
#           those are on the Settings page, because the client must be able to
#           change them without a developer.
#
# The three passwords below can be left blank and typed into the dashboard
# instead, which is the recommended route: the client enters their own
# credentials, the system encrypts them, and the developer never holds them.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED - the application refuses to start in production without these
# -----------------------------------------------------------------------------

# Encrypts every credential stored in the database. 32 random bytes, base64.
# Generate one with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# Losing it means re-entering the four credentials. Leaking it makes a database
# dump readable, which is why it lives here and never in the database.
# BACK IT UP somewhere separate from the database backups.
MASTER_KEY=

# Signs dashboard session cookies. Any random 32+ character string.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it signs everybody out, which is a feature after a suspected leak.
SESSION_SECRET=

# PostgreSQL. Required in production: a full feed upserts 1.15 million rows
# while the dashboard serves reads, and SQLite's single-writer lock makes that
# unusable. Docker Compose sets this for you.
DATABASE_URL=postgresql+psycopg://autopilot:CHANGE_ME@db:5432/autopilot


# -----------------------------------------------------------------------------
# 2. THE VENDOR'S FILE SERVER
# -----------------------------------------------------------------------------
# For All Media Supply, from the credentials supplied:
#   host: ftp.vendor.example.com    (the vendor's real host)
#   user: <the vendor's account name>
#   port: 21, "Explicit FTP over TLS"  ->  VENDOR_FTP_MODE=ftps

VENDOR_FTP_HOST=ftp.vendor.example.com
VENDOR_FTP_PORT=21
VENDOR_FTP_USER=

# ftps = explicit TLS on port 21 (this vendor). sftp = SSH on port 22.
# ftp = PLAINTEXT and refused unless ALLOW_PLAINTEXT_FTP=true, because it would
# put the vendor password on the wire in the clear.
VENDOR_FTP_MODE=ftps
ALLOW_PLAINTEXT_FTP=false

# Folder on the vendor's server. "/" is the login directory.
VENDOR_FTP_PATH=/

# Leave BLANK and type it into the dashboard instead. That way it is encrypted
# at rest and your developer never receives it.
VENDOR_FTP_PASSWORD=


# -----------------------------------------------------------------------------
# 3. AMAZON
# -----------------------------------------------------------------------------
# From the client's app, supplied 5 September 2026:
#   Client ID  amzn1.application-oa2-client.EXAMPLE00000000000000000000000000
#   Seller ID  A1EXAMPLESELLER
#   App ID     amzn1.sp.solution.00000000-0000-0000-0000-000000000000
#
# Amazon removed the AWS request-signing requirement from the Selling Partner
# API, so this needs NO AWS account, NO IAM user and NO role. Only the values
# below.

LWA_CLIENT_ID=amzn1.application-oa2-client.EXAMPLE00000000000000000000000000

# Seller Central -> Settings -> Account Info -> Merchant Token
SELLER_ID=A1EXAMPLESELLER

# US marketplace. The app is authorised for Mexico, Canada, United States and
# Brazil, but the client sells in the US only.
MARKETPLACE_ID=ATVPDKIKX0DER

# North America regional endpoint.
SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com

# Leave both BLANK and type them into the dashboard.
#
# The Client Secret is on the same Seller Central screen as the Client ID:
#   Apps and Services -> Develop Apps -> your app -> LWA credentials -> View
# It was the ONE credential not supplied with the others, and nothing can talk
# to Amazon without it.
LWA_CLIENT_SECRET=

# Apps and Services -> Develop Apps -> your app -> Authorize -> Authorize app
# About 400 characters, starts with "Atzr|".
# IMPORTANT: changing the app's roles invalidates the old token. If you have
# just added the "Product Listing" role, you need a NEW one.
LWA_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
# 4. ALERTS  (optional - the system works without email)
# -----------------------------------------------------------------------------
# Who receives what is set on the Settings page, not here.
# Alerts always appear on the dashboard whether or not email is configured.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=inventory-autopilot@example.com
SMTP_STARTTLS=true


# -----------------------------------------------------------------------------
# 5. THE APPLICATION
# -----------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# Used only to build links inside alert emails.
# The recommended deployment reaches the dashboard through a Cloudflare Tunnel
# or Tailscale, so there is no public login page to attack. See
# docs/DEPLOYMENT.md.
BASE_URL=http://localhost:8000

HOST=0.0.0.0
PORT=8000

# Exactly ONE process must own the scheduler. Set this to false on any extra
# container that should serve the dashboard only.
ENABLE_SCHEDULER=true

LOG_LEVEL=INFO
# JSON is easier to grep and ship on a server; set false for readable local
# development output.
LOG_JSON=true


# -----------------------------------------------------------------------------
# 6. DOCKER COMPOSE ONLY
# -----------------------------------------------------------------------------
# The password the database container is created with. It must match the one in
# DATABASE_URL above.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=autopilot
POSTGRES_DB=autopilot
