# Consistent whitespace across editors.
# See CONTRIBUTING.md for why `ruff format` is deliberately not used here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 110

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{html,css,js}]
indent_size = 2

[*.md]
# Markdown uses trailing whitespace for hard line breaks.
trim_trailing_whitespace = false

[*.{sh,ps1}]
indent_size = 4

[Makefile]
indent_style = tab

# .env is generated by setup-env.sh / setup-env.ps1 and must not be reformatted:
# python-dotenv is sensitive to a byte-order mark on the first line.
[.env*]
charset = unset
insert_final_newline = unset
